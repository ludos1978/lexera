// Phase 6.1 closing slice — narrow tsc --noEmit gate.
//
// This config does NOT type-check the whole codebase (which is full
// of IIFE-pattern globals that would noise-out useful errors). It
// only checks the @typedef blocks themselves are well-formed JSDoc
// by compiling each annotated file standalone with checkJs + noEmit.
//
// When a future slice converts a file to ESM, drop the file from
// `include` and add it to the broader esbuild-driven type-check.
//
// Run: ./node_modules/.bin/tsc -p tsconfig.typedef-check.json
// (driven by run-lexera-tests.sh --typedefs)
{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "lib": ["ES2018", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "src/types/lexera-globals.d.ts",
    "src/titleHelpers.js",
    "src/shell/inspectorShortcuts.js",
    "src/shell/lifecycle.js",
    "src/shell/panelLaunchers.js",
    "src/workspace/boardHost.js",
