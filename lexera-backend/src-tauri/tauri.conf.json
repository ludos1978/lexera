{
  "productName": "Lexera Backend",
  "version": "0.1.1",
  "identifier": "com.lexera.backend",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node ../lexera-shared/scripts/sync-runtime-assets.mjs src && node scripts/sync-frontend-view-assets.mjs",
    "beforeBuildCommand": "node ../lexera-shared/scripts/sync-runtime-assets.mjs src && node scripts/sync-frontend-view-assets.mjs"
  },
  "bundle": {
    "icon": ["icons/icon.png"]
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*"
    }
  }
}
