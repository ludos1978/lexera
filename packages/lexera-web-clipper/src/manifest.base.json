{
  "manifest_version": 3,
  "name": "Lexera Web Clipper",
  "description": "Clip links, selections, pages, articles, and images into Lexera kanban boards.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lexera Web Clipper",
    "default_popup": "popup.html"
  }
}
