{
  "productName": "Lexera Kanban",
  "version": "0.1.0",
  "identifier": "com.lexera.kanban",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "sh scripts/sync-excalidraw-assets.sh && cp ../lexera-shared/management.js ../lexera-shared/management.css src/",
    "beforeBuildCommand": "sh scripts/sync-excalidraw-assets.sh && cp ../lexera-shared/management.js ../lexera-shared/management.css src/"
  },
  "bundle": {
    "icon": ["icons/icon.png"]
  },
  "app": {
    "windows": [
      {
        "title": "Lexera Kanban",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "minWidth": 600,
        "minHeight": 400,
        "transparent": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*; img-src 'self' data: http://localhost:* http://127.0.0.1:*"
    }
  }
}
