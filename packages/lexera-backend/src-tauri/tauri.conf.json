{
  "productName": "Lexera Backend",
  "version": "0.1.0",
  "identifier": "com.lexera.backend",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "cp ../lexera-shared/management.js ../lexera-shared/management.css ../lexera-shared/themes.js src/",
    "beforeBuildCommand": "cp ../lexera-shared/management.js ../lexera-shared/management.css ../lexera-shared/themes.js src/"
  },
  "bundle": {
    "icon": ["icons/icon.png"]
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*"
    }
  }
}
